# Submissions carry the human-readable outputs/<model>.jsonl instead.
*.parquet

# Logs
*.log
*.err
*.out

# OS / editor / tooling
.DS_Store
.idea/
.vscode/
.claude/

# AppMap instrumentation 
appmap.yml
uv.lock

# Env
*.env

# Local secrets (Mattermost webhook, etc.)
.env

# tmp files
tmp/
**/tmp/
tmp.md

# Generated by scripts/update_space.py at deploy time and uploaded from there.
# Keeping these tracked meant the committed copies rotted between deploys, and
# conflicted on every branch that regenerated them.
huggingface/space/leaderboard.json
huggingface/space/cover.jpeg
